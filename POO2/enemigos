import pygame
import random
from config import COLOR_ENEMIGO, ANCHO_PANTALLA

class Enemigo:
    def __init__(self):
        self.ancho = 44
        self.alto = 44
        self.rect = pygame.Rect(
            random.randint(40, ANCHO_PANTALLA - 70),
            random.randint(-120, -40),
            self.ancho,
            self.alto
        )
        self.velocidad = random.randint(3, 6)

        # Cargar imagen del enemigo si existe
        try:
            self.imagen = pygame.image.load("enemigo.png").convert_alpha()
            self.imagen = pygame.transform.scale(self.imagen, (self.ancho, self.alto))
        except (FileNotFoundError, pygame.error):
            self.imagen = None

    def actualizar(self):
        self.rect.y += self.velocidad

    def dibujar(self, superficie):
        if self.imagen:
            superficie.blit(self.imagen, self.rect)
        else:
            pygame.draw.rect(superficie, COLOR_ENEMIGO, self.rect, border_radius=6)
